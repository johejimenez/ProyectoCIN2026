    :root {
      --brand-navy: #0b2742;
      --brand-cyan: #0ea5a5;
      --brand-gold: #f59e0b;
      --bg-soft: #f4f7fb;
      --text-dark: #12263a;
      --text-soft: #4a5a6a;
      --panel: #ffffff;
    }

    * { box-sizing: border-box; }

    body {
      margin: 0;
      font-family: "Manrope", sans-serif;
      color: var(--text-dark);
      background:
        radial-gradient(circle at 8% 10%, rgba(14, 165, 165, 0.11), transparent 25%),
        radial-gradient(circle at 90% 18%, rgba(245, 158, 11, 0.15), transparent 20%),
        linear-gradient(180deg, #f8fbff 0%, #eef4fa 100%);
      min-height: 100vh;
    }

    h1, h2, h3, h4 {
      font-family: "Sora", sans-serif;
      margin: 0;
    }

    .shell {
      width: min(1600px, 94vw);
      margin: 0 auto;
    }

    .header {
      position: sticky;
      top: 0;
      z-index: 30;
      backdrop-filter: blur(8px);
      background: linear-gradient(90deg, rgba(11, 39, 66, 0.95), rgba(6, 78, 125, 0.9));
      border-bottom: 1px solid rgba(255, 255, 255, 0.12);
    }

    .tab-scroll {
      overflow-x: auto;
      white-space: nowrap;
      scrollbar-width: thin;
    }

    .main-tab {
      border: 1px solid rgba(255, 255, 255, 0.22);
      color: rgba(255, 255, 255, 0.85);
      background: rgba(255, 255, 255, 0.06);
      transition: 0.25s ease;
    }

    .main-tab:hover {
      transform: translateY(-1px);
      background: rgba(255, 255, 255, 0.15);
    }

    .main-tab.active {
      color: #052130;
      background: linear-gradient(120deg, #fbbf24, #f59e0b);
      border-color: transparent;
      font-weight: 700;
    }

    .panel {
      background: var(--panel);
      border: 1px solid #dde6ef;
      border-radius: 18px;
      box-shadow: 0 12px 30px rgba(11, 39, 66, 0.08);
    }

    .sub-tab {
      border: 1px solid #d9e4ee;
      color: #29445d;
      background: #f5f9ff;
      transition: 0.2s ease;
    }

    .sub-tab.active {
      color: #fff;
      border-color: transparent;
      background: linear-gradient(120deg, #0b2742, #0f4b72);
      box-shadow: 0 10px 18px rgba(15, 75, 114, 0.25);
    }

    .program-card {
      background: #fff;
      border: 1px solid #dde6ef;
      border-radius: 16px;
      overflow: hidden;
      transition: transform 0.25s ease, box-shadow 0.25s ease;
      animation: riseIn 0.6s ease both;
    }

    .program-card:hover {
      transform: translateY(-6px);
      box-shadow: 0 18px 28px rgba(11, 39, 66, 0.16);
    }

    .pill {
      display: inline-block;
      border-radius: 999px;
      padding: 4px 10px;
      font-size: 12px;
      font-weight: 700;
    }

    .pill-high {
      background: rgba(34, 197, 94, 0.16);
      color: #166534;
    }

    .pill-growth {
      background: rgba(59, 130, 246, 0.16);
      color: #1d4ed8;
    }

    .pill-niche {
      background: rgba(148, 163, 184, 0.22);
      color: #334155;
    }

    .pill-saturation {
      background: rgba(249, 115, 22, 0.18);
      color: #c2410c;
    }

    .kpi {
      border-radius: 14px;
      border: 1px solid #dfe9f2;
      background: linear-gradient(160deg, #ffffff, #f8fbff);
    }

    .fade-in {
      animation: fadeIn 0.35s ease both;
    }

    .table-wrap {
      overflow-x: auto;
      border: 1px solid #dde7ef;
      border-radius: 12px;
    }

    table {
      width: 100%;
      border-collapse: collapse;
      font-size: 13px;
    }

    th, td {
      border-bottom: 1px solid #edf2f7;
      padding: 10px 12px;
      text-align: left;
      vertical-align: top;
    }

    th {
      color: #0b2742;
      background: #f6f9fd;
      font-size: 12px;
      text-transform: uppercase;
      letter-spacing: 0.04em;
    }

    .placeholder {
      border: 2px dashed #c7d6e6;
      border-radius: 16px;
      background: #f7fbff;
    }

    @keyframes fadeIn {
      from { opacity: 0; transform: translateY(4px); }
      to { opacity: 1; transform: translateY(0); }
    }

    @keyframes riseIn {
      from { opacity: 0; transform: translateY(16px); }
      to { opacity: 1; transform: translateY(0); }
    }
  </style>
