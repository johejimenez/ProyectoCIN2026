    let currentFaculty = "contexto";
    let currentSubtab = "indice";

    let charts = {};

    function formatCOP(value) {
      return "$" + Number(value).toLocaleString("es-CO");
    }

    function init() {
      renderMainTabs();
      renderSubTabs();
      renderFaculty();
    }

    function renderMainTabs() {
      const tabs = document.getElementById("mainTabs");
      tabs.innerHTML = faculties.map((f) => `
        <button class="main-tab active:text-slate-900 rounded-full px-4 py-2 text-xs md:text-sm ${f.id === currentFaculty ? "active" : ""}" onclick="switchFaculty('${f.id}')">${f.name}</button>
      `).join("");
    }

    function renderSubTabs() {
      const sub = document.getElementById("subTabs");
      if (currentFaculty === "contexto" || currentFaculty === "consolidado" || currentFaculty === "bases_extraidas") {
        sub.innerHTML = "";
        sub.classList.add("hidden");
        return;
      }
      sub.classList.remove("hidden");
      sub.innerHTML = `
        <button class="sub-tab rounded-lg px-4 py-2 text-sm ${currentSubtab === "indice" ? "active" : ""}" onclick="switchSubtab('indice')">Índice de Oportunidad</button>
        <button class="sub-tab rounded-lg px-4 py-2 text-sm ${currentSubtab === "empleabilidad" ? "active" : ""}" onclick="switchSubtab('empleabilidad')">Dashboard de Empleabilidad</button>
      `;
    }

    function switchFaculty(id) {
      currentFaculty = id;
      currentSubtab = "indice";
      renderMainTabs();
      renderSubTabs();
      renderFaculty();
    }

    function switchSubtab(tab) {
      currentSubtab = tab;
      renderSubTabs();
      renderFacultyContent();
    }

    function renderFaculty() {
      const faculty = faculties.find((f) => f.id === currentFaculty);
      document.getElementById("facultyTitle").textContent = faculty.name;
      document.getElementById("facultySubtitle").textContent = currentFaculty === "salud"
        ? ""
        : currentFaculty === "contexto"
        ? "Marco del proyecto, metodología del modelo y criterios de interpretación."
        : currentFaculty === "consolidado"
        ? "Vista consolidada de datos estratégicos del tablero."
        : currentFaculty === "bases_extraidas"
        ? "Registro de bases y fuentes extraídas para el análisis."
        : "Estructura lista para cargar información específica por programa.";
      renderFacultyContent();
    }

    function renderFacultyContent() {
      const indice = document.getElementById("contentIndice");
      const empleabilidad = document.getElementById("contentEmpleabilidad");

      if (currentFaculty === "contexto") {
        indice.classList.remove("hidden");
        empleabilidad.classList.add("hidden");
        indice.innerHTML = contextoIndiceMarkup();
        empleabilidad.innerHTML = "";
        return;
      }

      if (currentFaculty === "consolidado") {
        indice.classList.remove("hidden");
        empleabilidad.classList.add("hidden");
        indice.innerHTML = consolidadoDatosMarkup();
        empleabilidad.innerHTML = "";
        return;
      }

      if (currentFaculty === "bases_extraidas") {
        indice.classList.remove("hidden");
        empleabilidad.classList.add("hidden");
        indice.innerHTML = basesExtraidasMarkup();
        empleabilidad.innerHTML = "";
        return;
      }

      if (currentSubtab === "indice") {
        indice.classList.remove("hidden");
        empleabilidad.classList.add("hidden");
      } else {
        indice.classList.add("hidden");
        empleabilidad.classList.remove("hidden");
      }

      if (currentFaculty === "salud") {
        indice.innerHTML = saludIndiceMarkup();
        empleabilidad.innerHTML = saludEmpleabilidadMarkup();
        if (currentSubtab === "indice") {
          buildHealthIndexChart();
        } else {
          buildVacantesChart();
          buildSalariosChart();
          buildCiudadesChart();
          buildModalidadContratoCharts();
        }
      } else if (currentFaculty === "basicas") {
        indice.innerHTML = basicasIndiceMarkup();
        empleabilidad.innerHTML = basicasEmpleabilidadMarkup();
        if (currentSubtab === "indice") {
          buildBasicasIndiceChart();
        } else {
          buildBasicasVacantesChart();
          buildBasicasSalariosChart();
          buildBasicasCiudadesChart();
          buildBasicasModalidadChart();
        }
      } else if (currentFaculty === "humanidades") {
        indice.innerHTML = placeholderMarkup("Índice de Oportunidad", "Aquí se deben cargar los programas, puntajes digital/laboral, índice y clasificación de esta escuela.");
        empleabilidad.innerHTML = humanidadesEmpleabilidadMarkup();
        if (currentSubtab === "empleabilidad") {
          buildHumanidadesVacantesChart();
          buildHumanidadesSalariosChart();
          buildHumanidadesCiudadesChart();
        }
      } else {
        indice.innerHTML = placeholderMarkup("Índice de Oportunidad", "Aquí se deben cargar los programas, puntajes digital/laboral, índice y clasificación de esta facultad.");
        empleabilidad.innerHTML = placeholderMarkup("Dashboard de Empleabilidad", "Aquí se deben cargar KPIs, vacantes, salarios, ciudades, competencias, modalidad y contratos de esta facultad.");
      }
    }

